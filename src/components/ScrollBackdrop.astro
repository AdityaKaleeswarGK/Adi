<!-- A decorative, scroll-bound surface. No canvas, timers, or scroll capture. -->
<div class="scroll-backdrop" aria-hidden="true">
  <svg class="terrain terrain-far" viewBox="0 0 1000 1000" fill="none">
    {Array.from({length:12}, (_, i) => <path d={`M ${420+i*28} -80 C ${120+i*25} ${170+i*9}, ${960-i*16} ${220+i*13}, ${700+i*19} ${510+i*13} S ${100+i*33} ${770+i*10}, ${360+i*28} 1150`}/>)}
  </svg>
  <svg class="terrain terrain-near" viewBox="0 0 1000 1000" fill="none">
    {Array.from({length:9}, (_, i) => <path d={`M -100 ${180+i*38} C ${140+i*20} ${-100+i*24}, ${240+i*18} ${730-i*10}, ${570+i*18} ${510+i*29} S ${900+i*5} ${400+i*34}, 1200 ${780+i*24}`}/>)}
  </svg>
  <div class="backdrop-shade"></div>
</div>

<style>
  .scroll-backdrop { position:fixed; inset:0; z-index:0; pointer-events:none; overflow:hidden; background:#101218; --drift:0; }
  .terrain { position:absolute; width:115vmax; height:115vmax; stroke-width:.65; will-change:transform; }
  .terrain-far { top:-42vmax; right:-28vmax; stroke:#94b8ef; opacity:.34; transform:translate3d(calc(var(--drift) * -42vw),calc(var(--drift) * 58vh),0) rotate(calc(var(--drift) * 38deg)); }
  .terrain-near { top:30vh; left:-60vmax; stroke:#b6a3d6; opacity:.2; transform:translate3d(calc(var(--drift) * 36vw),calc(var(--drift) * -40vh),0) rotate(calc(var(--drift) * -28deg)); }
  .backdrop-shade { position:absolute; inset:0; background:linear-gradient(90deg,#10121850,transparent 90%),radial-gradient(ellipse at 45% 50%,#101218a0,transparent 85%); }
  @media(max-width:600px) { .terrain-far { opacity:.2; right:-65vmax; } .terrain-near { opacity:.12; } }
  @media(prefers-reduced-motion:reduce) { .terrain { transform:none; will-change:auto; } }
</style>

<script>
  let dispose: (() => void) | undefined;
  const setupBackdrop = () => {
    dispose?.();
    const surface = document.querySelector<HTMLElement>('.scroll-backdrop');
    if (!surface) return;
    const motion = window.matchMedia('(prefers-reduced-motion: reduce)');
    let frame = 0;
    const paint = () => {
      frame = 0;
      const range = document.documentElement.scrollHeight - window.innerHeight;
      const progress = range > 0 ? Math.max(0, Math.min(1, window.scrollY / range)) : 0;
      // Smoothstep eases the shape into a resting position at either end.
      surface.style.setProperty('--drift', String(motion.matches ? 0 : progress * progress * (3 - 2 * progress)));
    };
    const schedule = () => { if (!frame) frame = requestAnimationFrame(paint); };
    window.addEventListener('scroll', schedule, { passive:true });
    window.addEventListener('resize', schedule);
    motion.addEventListener('change', schedule);
    const observer = new ResizeObserver(schedule);
    observer.observe(document.body);
    paint();
    dispose = () => {
      window.removeEventListener('scroll', schedule);
      window.removeEventListener('resize', schedule);
      motion.removeEventListener('change', schedule);
      observer.disconnect();
      cancelAnimationFrame(frame);
    };
  };
  document.addEventListener('astro:page-load', setupBackdrop);
  document.addEventListener('astro:before-swap', () => dispose?.());
</script>
