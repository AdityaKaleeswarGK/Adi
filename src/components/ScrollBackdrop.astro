<!-- A decorative, scroll-bound surface. No canvas, timers, or scroll capture. -->
<div class="scroll-backdrop" aria-hidden="true">
  <div class="backdrop-orbit orbit-one"></div>
  <div class="backdrop-orbit orbit-two"></div>
  <div class="backdrop-shade"></div>
</div>

<style>
  .scroll-backdrop { position:fixed; inset:0; z-index:0; pointer-events:none; overflow:hidden; background:#101218; --drift:0; }
  .backdrop-orbit { position:absolute; width:95vmax; height:95vmax; border-radius:38%; border:1px solid #a9c5ff55; background:radial-gradient(ellipse at 60% 32%, #577bbc45, #28385330 43%, transparent 70%); box-shadow:inset 0 0 100px #5f87c918; will-change:transform; }
  .orbit-one { left:38%; top:-62vmax; transform:translate3d(calc(var(--drift) * -46vw),calc(var(--drift) * 68vh),0) rotate(calc(var(--drift) * 110deg)); }
  .orbit-two { right:45%; top:52vh; width:85vmax; height:85vmax; border-color:#c1b6ef38; background:radial-gradient(ellipse at 65% 40%,#6b5d9e35,transparent 66%); transform:translate3d(calc(var(--drift) * 65vw),calc(var(--drift) * -65vh),0) rotate(calc(var(--drift) * -80deg)); }
  .backdrop-shade { position:absolute; inset:0; background:linear-gradient(90deg,#10121890,transparent 80%); }
  @media(max-width:600px) { .backdrop-orbit { opacity:.65; } }
  @media(prefers-reduced-motion:reduce) { .backdrop-orbit { transform:none; will-change:auto; } }
</style>

<script>
  let dispose: (() => void) | undefined;
  const setupBackdrop = () => {
    dispose?.();
    const surface = document.querySelector<HTMLElement>('.scroll-backdrop');
    if (!surface) return;
    const motion = window.matchMedia('(prefers-reduced-motion: reduce)');
    let frame = 0;
    const paint = () => {
      frame = 0;
      const range = document.documentElement.scrollHeight - window.innerHeight;
      const progress = range > 0 ? Math.max(0, Math.min(1, window.scrollY / range)) : 0;
      // Smoothstep eases the shape into a resting position at either end.
      surface.style.setProperty('--drift', String(motion.matches ? 0 : progress * progress * (3 - 2 * progress)));
    };
    const schedule = () => { if (!frame) frame = requestAnimationFrame(paint); };
    window.addEventListener('scroll', schedule, { passive:true });
    window.addEventListener('resize', schedule);
    motion.addEventListener('change', schedule);
    const observer = new ResizeObserver(schedule);
    observer.observe(document.body);
    paint();
    dispose = () => {
      window.removeEventListener('scroll', schedule);
      window.removeEventListener('resize', schedule);
      motion.removeEventListener('change', schedule);
      observer.disconnect();
      cancelAnimationFrame(frame);
    };
  };
  document.addEventListener('astro:page-load', setupBackdrop);
  document.addEventListener('astro:before-swap', () => dispose?.());
</script>
