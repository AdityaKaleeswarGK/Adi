<!-- A decorative, scroll-bound surface. No canvas, timers, or scroll capture. -->
<div class="scroll-backdrop" aria-hidden="true">
  <div class="backdrop-light"></div>
  <svg class="ribbon ribbon-blue" viewBox="0 0 1440 1000" preserveAspectRatio="xMidYMid slice" fill="none">
    <path d="M1050 -600 C260 -20 150 400 860 740 S1880 1280 980 1800 L1240 1900 C2200 1050 1380 740 1010 560 S660 100 1430 -420 Z" />
  </svg>
  <svg class="ribbon ribbon-violet" viewBox="0 0 1440 1000" preserveAspectRatio="xMidYMid slice" fill="none">
    <path d="M-650 150 C-150 0 120 250 180 650 S620 1160 1670 850 L1720 990 C500 1450 -30 1050 -10 670 S-260 220 -650 350 Z" />
  </svg>
</div>

<style>
  .scroll-backdrop { position:fixed; inset:0; z-index:0; pointer-events:none; overflow:hidden; background:var(--color-bg); --drift:0; }
  .backdrop-light { position:absolute; inset:0; background:radial-gradient(ellipse at 90% 20%,#25364a55,transparent 65%); }
  .ribbon { position:absolute; top:-20%; left:-20%; width:140%; height:140%; will-change:transform; }
  .ribbon-blue { transform:translate3d(calc(var(--drift) * -10vw),calc(var(--drift) * 8vh),0) rotate(calc(var(--drift) * 15deg)); }
  .ribbon-blue path { fill:#263a5666; stroke:#88aee84d; stroke-width:1; }
  .ribbon-violet { transform:translate3d(calc(var(--drift) * 9vw),calc(var(--drift) * -12vh),0) rotate(calc(var(--drift) * -12deg)); }
  .ribbon-violet path { fill:#39324640; stroke:#a498c433; stroke-width:1; }
  @media(max-width:600px) { .ribbon-blue path { fill:#263a564a; }.ribbon-violet path { fill:#39324630; } }
  @media(prefers-reduced-motion:reduce) { .ribbon { transform:none; will-change:auto; } }
</style>

<script>
  let dispose: (() => void) | undefined;
  const setupBackdrop = () => {
    dispose?.();
    const surface = document.querySelector<HTMLElement>('.scroll-backdrop');
    if (!surface) return;
    const motion = window.matchMedia('(prefers-reduced-motion: reduce)');
    let frame = 0;
    const paint = () => {
      frame = 0;
      const range = document.documentElement.scrollHeight - window.innerHeight;
      const progress = range > 0 ? Math.max(0, Math.min(1, window.scrollY / range)) : 0;
      // Smoothstep eases the shape into a resting position at either end.
      surface.style.setProperty('--drift', String(motion.matches ? 0 : progress * progress * (3 - 2 * progress)));
    };
    const schedule = () => { if (!frame) frame = requestAnimationFrame(paint); };
    window.addEventListener('scroll', schedule, { passive:true });
    window.addEventListener('resize', schedule);
    motion.addEventListener('change', schedule);
    const observer = new ResizeObserver(schedule);
    observer.observe(document.body);
    paint();
    dispose = () => {
      window.removeEventListener('scroll', schedule);
      window.removeEventListener('resize', schedule);
      motion.removeEventListener('change', schedule);
      observer.disconnect();
      cancelAnimationFrame(frame);
    };
  };
  document.addEventListener('astro:page-load', setupBackdrop);
  document.addEventListener('astro:before-swap', () => dispose?.());
</script>
