<pipeline-story class="pipeline-story" data-stage="5">
  <header><span class="story-eyebrow">How the pipeline works</span><div class="story-heading"><h2>One image, step by step.</h2></div></header>
  <div class="story-stage">
    <div class="story-film" aria-hidden="true">
      <svg viewBox="0 0 720 390">
        <defs><linearGradient id="block-face" x2="1" y2="1"><stop stop-color="#777681"/><stop offset="1" stop-color="#41414b"/></linearGradient><pattern id="block-grain" width="27" height="23" patternUnits="userSpaceOnUse"><path d="M4 7l3 1m12 8l2-1" stroke="#c8c3cb" stroke-opacity=".18"/></pattern></defs>
        <g class="story-block">
          <path d="M210 85l30-24h310l-30 24v210l30-24V61" fill="#34333e" stroke="#767280"/>
          <rect x="210" y="85" width="310" height="210" rx="2" fill="url(#block-face)" stroke="#8e8896"/>
          <rect x="210" y="85" width="310" height="210" fill="url(#block-grain)"/>
          <rect class="story-member" x="210" y="85" width="310" height="210" fill="#8ab4f8" fill-opacity=".25" stroke="#8ab4f8" stroke-width="3"/>
          <path d="M210 190l22-4 17 3 19-5 16 3 21-4" fill="none" stroke="#15151b" stroke-width="6"/>
          <path class="story-crack" d="M210 190l22-4 17 3 19-5 16 3 21-4" fill="none" stroke="#f2a279" stroke-width="4" pathLength="1"/>
          <g class="story-orientation" stroke="#bca8e6" fill="none"><path d="M190 192l205-14" stroke-dasharray="5 5"/><path d="M380 172l15 6-14 8M204 185l-14 7 15 6"/></g><text class="story-orientation" x="375" y="153" fill="#c9b7ea" font-size="13">Orientation axis</text>
          <g class="story-points" fill="#c4a9f3"><circle cx="235" cy="170" r="4"/><circle cx="275" cy="168" r="4"/><circle cx="235" cy="207" r="4"/><circle cx="275" cy="206" r="4"/></g>
          <g class="story-rulers" fill="none" stroke="#edc57d" stroke-width="1.5"><path d="M210 316h310m-310-6v12m310-12v12M210 153h95m-95-6v12m95-12v12"/><path d="M210 190H520" stroke-dasharray="4 5"/></g>
          <g class="story-rulers" fill="#edc57d" text-anchor="middle" font-size="13"><text x="257" y="140">Crack length</text><text x="365" y="344">Member extent</text></g>
        </g>
        
        <path class="story-frame" d="M197 112V72h40m257 0h40v40m0 155v40h-40m-257 0h-40v-40" stroke="#d9c7f4" stroke-width="2" fill="none"/>
        <rect class="story-flash" x="197" y="72" width="337" height="235" fill="#f7efff"/>
        <g class="story-scale" fill="#bca8e6"><rect x="556" y="123" width="115" height="131" rx="9" fill="#262230" stroke="#716185"/><text x="613" y="157" text-anchor="middle" font-size="13">Calibrate</text><path d="M574 185h78m-78-8v16m19-12v8m20-12v16m19-12v8m20-12v16" stroke="#c5ade9"/><text x="613" y="222" text-anchor="middle" font-size="12">Reference or</text><text x="613" y="239" text-anchor="middle" font-size="12">metric depth</text></g>
      </svg>
      <div class="story-result"><span>Geometry meets mechanics</span><div class="result-inputs"><b>Measured geometry</b><i>+</i><b>Supplied load</b><i>+</i><b>Stored geometry factor</b></div><strong>Crack-tip loading</strong><p>A stress-intensity estimate for the chosen model</p><div>Compare with supplied material toughness.<br/>The image alone cannot determine a safety verdict.</div></div>
    </div>
    <div class="story-map" aria-label="Complete pipeline architecture">
      <div class="map-lane-label">PERCEPTION</div><div class="map-capture"><b>01 / Image</b><strong>RGB image</strong><span>Crack and surrounding member</span></div>
      <div class="map-down" aria-hidden="true">↓</div>
      <div class="map-branches">
        <div class="map-crack"><b>02 / Crack segmentation</b><strong>Trace → centreline</strong><span>Length & orientation</span></div>
        <div class="map-member"><b>03 / MobileSAM</b><strong>Member surface</strong><span>Prompts from crack → boundary extent</span></div>
        <div class="map-scale"><b>04 / Scale source</b><strong>Pixels → millimetres</strong><span>Monocular depth, sensor or calibration</span></div>
      </div>
      <div class="map-down" aria-hidden="true">↓</div>
      <div class="map-geometry"><strong>Physical geometry</strong><span>Check boundaries, view geometry & model compatibility</span></div>
      <div class="map-lane-label mechanics-label">MECHANICS · OFFLINE FACTORS + SUPPLIED INPUTS</div><div class="map-inputs"><span>External load & material inputs ↘</span><span>Offline PINN factor bank ↙</span></div>
      <div class="map-output"><b>05 / Mechanics evaluation</b><strong>Stress intensity & toughness ratio</strong><span>Analytical fallback identified separately</span></div>
    </div>
  </div>
  <div class="story-caption" aria-live="polite"><span data-counter>06 / 06</span><h3 data-title>The complete architecture</h3><p data-caption>Image-derived geometry meets external load and material inputs. The PINN is solved offline; the stored factors support the final evaluation.</p></div>
  <div class="story-actions"><button type="button" data-play aria-label="Replay walkthrough" title="Replay walkthrough"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 10a8 8 0 1 1 1 7M4 4v6h6"/></svg></button><button type="button" data-overview aria-label="Show complete architecture" title="Show complete architecture"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="8" y="2" width="8" height="5" rx="1"/><path d="M12 7v5M4 16v-4h16v4"/><rect x="1" y="16" width="6" height="6" rx="1"/><rect x="9" y="16" width="6" height="6" rx="1"/><rect x="17" y="16" width="6" height="6" rx="1"/></svg></button></div>
  <div class="story-progress" aria-label="Animation chapters">{['Image','Trace','Surface','Measure','Evaluate','Overview'].map((name,i)=><button type="button" data-chapter={i} aria-label={`Show ${name.toLowerCase()} stage`} aria-pressed={i===5?'true':'false'}><span></span>{name}</button>)}</div>
  <p class="story-note">Illustrated walkthrough, not live model inference. Geometry, loading and model compatibility are checked before interpreting an estimate.</p>
</pipeline-story>
<style>
.pipeline-story{display:block;margin:2rem 0;background:radial-gradient(ellipse at 50% 30%,#292532,#19191f 75%);border:1px solid #48404f;border-radius:18px;overflow:hidden;text-align:left}.pipeline-story header{padding:24px 26px 0}.story-eyebrow{font:10px monospace;letter-spacing:.14em;text-transform:uppercase;color:#bca8e6}.story-heading{display:flex;align-items:center;justify-content:space-between;gap:15px}.story-heading h2{font:27px/1.2 Georgia,serif;margin:12px 0}.story-actions{display:flex;gap:8px;padding:16px 26px 0}.story-actions button{font:22px sans-serif;width:36px;height:36px;display:grid;place-items:center;padding:0;border:1px solid #665775;border-radius:8px;color:#ddd1eb;background:#28222f;cursor:pointer}.story-stage{position:relative;min-height:455px;display:grid;align-items:center}.story-film,.story-map{grid-area:1/1;transition:opacity .9s,transform 1.2s cubic-bezier(.2,.7,.2,1)}.story-film svg{width:100%;overflow:visible;display:block}.story-block{transform-origin:365px 190px;transition:transform 1.4s}.story-orientation,.story-frame,.story-scale,.story-rulers,.story-member,.story-points{transition:opacity .9s,transform 1s;opacity:0}.story-crack{stroke-dasharray:1;stroke-dashoffset:1;transition:stroke-dashoffset 1.7s ease}.story-flash{opacity:0}.story-map{opacity:0;transform:scale(.85) translateY(25px);pointer-events:none;padding:20px 25px;color:#dfd8e4;text-align:center}.story-map b{font:9px/1.5 monospace;letter-spacing:.04em;color:#c4b4d9;display:block}.story-map strong{display:block;font:14px/1.5 sans-serif}.story-map span{display:block;font-size:10px;line-height:1.5;color:#b9afc3;margin-top:4px}.map-capture,.map-geometry,.map-output{max-width:380px;margin:auto;padding:10px;border:1px solid #655773;border-radius:8px;background:#26212e}.map-down{color:#8c799e;font-size:19px;line-height:25px}.map-branches{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}.map-branches>div{border:1px solid #524958;border-top:2px solid #e5a17f;padding:12px 6px;border-radius:7px;background:#25212b}.map-branches .map-member{border-top-color:#8ab4f8}.map-branches .map-scale{border-top-color:#bca8e6}.map-inputs{display:flex;justify-content:center;gap:25px;padding:12px 0}.map-output{border-color:#9a8157}.map-output strong{color:#edc57d}.story-result{position:absolute;inset:80px 25px auto;text-align:center;opacity:0;transform:translateY(20px);transition:opacity 1s,transform 1s}.story-result>span{font:11px monospace;color:#d8b982;text-transform:uppercase;letter-spacing:.12em}.story-result strong{display:block;font:72px/1.3 Georgia,serif;color:#f0d09a;margin:15px 0}.story-result strong small{font-size:22px}.story-result p{font-size:17px;color:#eee3d4}.story-result div{font-size:11px;line-height:1.9;color:#b8aebf;margin-top:24px}.story-caption{padding:0 26px;min-height:115px}.story-caption>span{font:10px monospace;color:#bca8e6}.story-caption h3{font:23px Georgia,serif;margin:7px 0}.story-caption p{font-size:13px;line-height:1.7;color:#c7bfce;margin:0}.story-progress{display:flex;gap:6px;padding:16px 26px}.story-progress button{flex:1;border:0;background:none;color:#aaa0b5;font:10px sans-serif;text-align:left;cursor:pointer;padding:0}.story-progress button span{display:block;height:3px;background:#47404f;margin-bottom:8px;border-radius:3px}.story-progress button[aria-pressed=true]{color:#eee0ff}.story-progress button[aria-pressed=true] span{background:#c4a9eb}.story-note{font-size:10px!important;line-height:1.7!important;color:#9e95a9;margin:0!important;padding:0 26px 22px}.pipeline-story button:focus-visible{outline:2px solid #edc57d;outline-offset:4px}
[data-stage="0"] .story-frame{opacity:1}[data-stage="0"] .story-flash{animation:capture-flash 2s ease both}[data-stage="1"] .story-block{transform:translate(-15px,5px) scale(1.15)}[data-stage="1"] .story-orientation{opacity:1}[data-stage="1"] .story-crack,[data-stage="2"] .story-crack,[data-stage="3"] .story-crack{stroke-dashoffset:0}[data-stage="2"] .story-member,[data-stage="2"] .story-points,[data-stage="3"] .story-member,[data-stage="3"] .story-rulers,[data-stage="3"] .story-scale{opacity:1}[data-stage="4"] .story-film svg{opacity:.08;transform:scale(.9);transition:opacity .9s,transform .9s}[data-stage="4"] .story-result{opacity:1;transform:none}[data-stage="5"] .story-film{opacity:0;transform:scale(.65);pointer-events:none}[data-stage="5"] .story-map{opacity:1;transform:none;pointer-events:auto}@keyframes capture-flash{0%,30%,100%{opacity:0}40%{opacity:.8}}
@media(max-width:600px){.pipeline-story header{padding:20px 16px 0}.story-heading{align-items:flex-start;flex-direction:column;gap:0}.story-heading h2{font-size:24px}.story-stage{min-height:480px}.story-map{padding:20px 14px}.map-branches{gap:6px}.story-map strong{font-size:11px}.story-map b{font-size:8px}.story-map span{font-size:9px}.map-inputs{gap:10px}.story-caption{padding:0 16px;min-height:145px}.story-progress{padding:15px 16px;gap:5px}.story-progress button{font-size:9px}.story-note{padding-inline:16px}.story-result{inset:115px 15px auto}.story-result strong{font-size:54px}.story-result strong small{font-size:17px}}
@media(prefers-reduced-motion:reduce){.pipeline-story *{transition:none!important;animation:none!important}}

.result-inputs{display:flex;justify-content:center;align-items:center;gap:12px!important;margin-top:25px!important}.result-inputs b{padding:12px;border:1px solid #665371;border-radius:8px;font:12px/1.6 sans-serif;background:#292130}.result-inputs i{color:#bea2dc}.story-result strong{font-size:42px}.story-map{background:radial-gradient(ellipse at center,#30253a,transparent 70%)}.map-branches>div{box-shadow:0 8px 25px #100c1533}.map-output{background:linear-gradient(120deg,#362b20,#28212e)}[data-stage="5"] .map-capture,[data-stage="5"] .map-branches,[data-stage="5"] .map-geometry,[data-stage="5"] .map-inputs,[data-stage="5"] .map-output{animation:map-arrive .8s both}[data-stage="5"] .map-branches{animation-delay:.15s}[data-stage="5"] .map-geometry{animation-delay:.3s}[data-stage="5"] .map-inputs{animation-delay:.45s}[data-stage="5"] .map-output{animation-delay:.6s}[data-stage="3"] .story-rulers{stroke-dasharray:900;animation:measure-draw 1.8s ease both}[data-stage="3"] .story-scale{animation:map-arrive 1s .4s both}@keyframes map-arrive{from{opacity:0;transform:translateY(18px)}to{opacity:1;transform:translateY(0)}}@keyframes measure-draw{from{stroke-dashoffset:900}to{stroke-dashoffset:0}}@media(max-width:500px){.story-result strong{font-size:30px}.result-inputs{gap:5px!important}.result-inputs b{font-size:10px;padding:8px}}@media(prefers-reduced-motion:reduce){.pipeline-story *{animation:none!important}}
.map-lane-label{font:9px monospace;letter-spacing:.12em;color:#a996bf;text-align:left;margin-bottom:8px}.mechanics-label{border-top:1px dashed #55465f;padding-top:12px;margin-top:15px}.map-branches{position:relative}.map-geometry{border-color:#8b7ca3}.map-output{max-width:440px}.story-stage{min-height:520px}.map-capture strong{color:#e3d8ef}.map-crack strong{color:#e8ad8e}.map-member strong{color:#a9c8f5}.map-scale strong{color:#d4b9f3}
</style>
<script>
class PipelineStory extends HTMLElement {
 private timer: ReturnType<typeof setTimeout>|undefined;
 private observer: IntersectionObserver|undefined;
 connectedCallback(){
  if(this.dataset.ready)return;this.dataset.ready='true';
  let stage=5,playing=false,started=false;
  const reduced=window.matchMedia('(prefers-reduced-motion: reduce)');
  const chapters=[['Start with an image','One RGB frame contains the visible crack and the surrounding member. The frame must include the boundaries needed for measurement.'],['Extract length and orientation','The selected crack pixels become a centreline. Its path gives length. The dashed, two-ended line shows the dominant orientation, not a predicted direction of growth.'],['Find the member','Points beside the crack prompt MobileSAM to select the surrounding surface. The crack direction guides a boundary-to-boundary chord; this still needs to match the mechanics geometry.'],['Convert image measurements to millimetres','Monocular depth, an aligned sensor or calibration supplies scale. Pixel measurements become physical dimensions.'],['Evaluate the chosen crack model','Compatible geometry joins an externally supplied load and a stored PINN geometry factor to estimate stress intensity.'],['The complete architecture','Image-derived geometry meets external load and material inputs. The PINN is solved offline; the stored factors support the final evaluation.']];
  const play=this.querySelector<HTMLButtonElement>('[data-play]')!;
  const show=(n:number)=>{stage=n;this.dataset.stage=String(n);this.querySelector('[data-counter]')!.textContent=`0${n+1} / 06`;this.querySelector('[data-title]')!.textContent=chapters[n][0];this.querySelector('[data-caption]')!.textContent=chapters[n][1];this.querySelectorAll<HTMLButtonElement>('[data-chapter]').forEach(b=>b.setAttribute('aria-pressed',String(Number(b.dataset.chapter)===n)));};
  const stop=()=>{clearTimeout(this.timer);playing=false;play.innerHTML=stage===5?'<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 10a8 8 0 1 1 1 7M4 4v6h6"/></svg>':'<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round" aria-hidden="true"><path d="m8 5 11 7-11 7Z"/></svg>';play.setAttribute('aria-label',stage===5?'Replay walkthrough':'Play walkthrough');play.title=play.getAttribute('aria-label')!;};
  const next=()=>{if(stage===5){stop();return;}this.timer=setTimeout(()=>{show(stage+1);next();},stage===4?4500:3200);};
  const start=()=>{started=true;playing=true;play.innerHTML='<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true"><path d="M8 5v14M16 5v14"/></svg>';play.setAttribute('aria-label','Pause walkthrough');play.title='Pause walkthrough';if(stage===5)show(0);next();};
  play.addEventListener('click',()=>{if(playing)stop();else start();});
  this.querySelector('[data-overview]')!.addEventListener('click',()=>{started=true;show(5);stop();});
  this.querySelectorAll<HTMLButtonElement>('[data-chapter]').forEach(b=>b.addEventListener('click',()=>{started=true;show(Number(b.dataset.chapter));stop();}));
  this.observer=new IntersectionObserver(entries=>{for(const entry of entries){if(entry.isIntersecting&&!started&&!reduced.matches)start();else if(!entry.isIntersecting){stop();started=false;stage=5;}}},{threshold:0,rootMargin:'-20% 0px -20% 0px'});this.observer.observe(this.querySelector('.story-stage')!);
 }
 disconnectedCallback(){clearTimeout(this.timer);this.observer?.disconnect();}
}
if(!customElements.get('pipeline-story'))customElements.define('pipeline-story',PipelineStory);
</script>
