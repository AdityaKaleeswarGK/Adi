<mask-inspector class="inspection" data-compare="true">
 <header><span>Actual saved inference · SUT-Crack / image 1</span><h3>Reference and prediction, side by side</h3></header>
 <button type="button" class="mask-replay" aria-label="Replay mask sequence" title="Replay mask sequence"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 10a8 8 0 1 1 1 7M4 4v6h6"/></svg></button>
 <div class="inspect-layout">
  <div class="comparison-images"><div class="image-window"><img src="/blog/pinn/sut-1-comparison.jpg" alt="SUT-Crack image 1, original photograph from the saved validation comparison" width="1350" height="635" loading="lazy" data-view-image style="left:-100%" /><span class="image-label" data-image-label>Reference</span></div><div class="image-window comparison-prediction"><img src="/blog/pinn/sut-1-comparison.jpg" alt="Saved prediction in red" width="1350" height="635" loading="lazy" style="left:-200%"/><span class="image-label">Prediction</span></div></div>
  <div class="inspector-tools">
   <div role="group" aria-label="Saved crack images"><button type="button" data-frame="3" aria-pressed="true">Compare both</button><button type="button" data-frame="0" aria-pressed="false">01 · Original image</button><button type="button" data-frame="1" aria-pressed="false">02 · Reference mask</button><button type="button" data-frame="2" aria-pressed="false">03 · Model prediction</button></div>
   <p data-description aria-live="polite">Compare the same image region: green is the dataset reference and red is the saved prediction. Look for changes in thickness and gaps along the trace.</p>
   <dl><div><dt>Checkpoint</dt><dd>YOLOv8n · OpenSistemas</dd></div><div><dt>Input</dt><dd>Grayscale + CLAHE</dd></div><div><dt>Overlap IoU</dt><dd>0.312 for this image</dd></div></dl>
  </div>
 </div>
 <figcaption>Saved exploratory baseline, not a new model run. Green = dataset reference; red = predicted foreground. These are crack masks, not MobileSAM member masks. The field of view does not establish specimen boundaries or validate a fracture calculation. Source: <a href="https://data.mendeley.com/datasets/gsbmknrhkv/6">SUT-Crack, Sabouri & Sepidbar</a>; local run <code>sut_yolov8n_smoke</code>, image 1.</figcaption>
</mask-inspector>
<style>
.inspection{display:block;border-block:1px solid #41414e;margin:2.5rem 0;padding:24px 0}.inspection header span{font:11px monospace;color:#b6a7df;text-transform:uppercase;letter-spacing:.05em}.inspection h3{font:24px/1.3 Georgia,serif;margin:8px 0 22px}.inspect-layout{display:grid;gap:18px}.comparison-images{display:grid;grid-template-columns:1fr 1fr;gap:12px;max-width:600px;margin:auto;width:100%}.inspection:not([data-compare=true]) .comparison-images{grid-template-columns:1fr;max-width:300px}.inspection:not([data-compare=true]) .comparison-prediction{display:none}.image-label{position:absolute;bottom:8px;left:8px;background:#19161ee6;color:#eee7f5;border:1px solid #655772;border-radius:4px;padding:4px 8px;font-size:11px}.inspector-tools [role=group]{display:flex;gap:8px;flex-wrap:wrap}.inspector-tools [role=group] button{flex:1;min-width:110px}.inspector-tools dl{display:flex;gap:20px;justify-content:space-between}.inspector-tools dl>div{flex:1}.image-window{position:relative;aspect-ratio:450/635;overflow:hidden;border-radius:3px;background:#25242d}.image-window img{position:absolute;top:0;left:0;width:300%;max-width:none!important;height:100%;border:0!important;border-radius:0!important}.inspector-tools button{display:block;text-align:left;border:1px solid #555164;background:transparent;width:100%;padding:11px 14px;border-radius:4px;color:#cac2d5;margin-bottom:8px;font-size:12px;cursor:pointer}.inspector-tools button[aria-pressed=true]{background:#b6a7df;color:#211c2d}.inspector-tools button:focus-visible{outline:2px solid #dfb779;outline-offset:3px}.inspector-tools p{font-size:13px;line-height:1.8;min-height:0}.inspector-tools dl{font-size:11px;margin-top:20px}.inspector-tools dl>div{border-top:1px solid #41414e;padding:8px 0}.inspector-tools dt{color:#ada5bc}.inspector-tools dd{margin:3px 0}.inspection figcaption{font-size:11px;line-height:1.8;color:#b5aebb;margin-top:16px;text-align:left}@media(max-width:520px){.inspect-layout{grid-template-columns:1fr}.image-window{max-height:420px;aspect-ratio:450/635;width:100%;margin:auto}.inspector-tools p{min-height:0}.inspection h3{font-size:21px}}
.mask-replay{border:1px solid #756387;border-radius:8px;display:grid;place-items:center;width:34px;height:34px;background:#292031;color:#dac6f1;font-size:21px;cursor:pointer;margin-bottom:16px}.mask-replay:focus-visible{outline:2px solid #edc57d}.comparison-images{min-height:420px;align-items:center}.image-window{max-height:420px}.inspection h3{margin-bottom:12px}@media(max-width:520px){.comparison-images{min-height:360px}.image-window{max-height:360px}}
</style>
<script>
import { animate } from 'motion';
class MaskInspector extends HTMLElement {
 private timer: ReturnType<typeof setTimeout>|undefined;
 private observer?: IntersectionObserver;
 connectedCallback(){if(this.dataset.ready)return;this.dataset.ready='true';let started=false,playing=false,selected=0;const reduced=matchMedia('(prefers-reduced-motion: reduce)').matches;const replay=this.querySelector<HTMLButtonElement>('.mask-replay')!;
 const copy=['Start with the original photograph: texture, lighting and the visible crack.','The green overlay is the dataset reference mask.','The red overlay is the saved model prediction. Compare its thickness and continuity.','Reference and prediction together: the same image, different selected pixels.'];
 const show=(n:number)=>{selected=n;const index=n===3?1:n;this.dataset.compare=String(n===3);this.dataset.frame=String(n);this.querySelector('[data-image-label]')!.textContent=['Original','Reference','Prediction'][index];this.querySelectorAll<HTMLButtonElement>('[data-frame]').forEach(b=>b.setAttribute('aria-pressed',String(Number(b.dataset.frame)===n)));const image=this.querySelector<HTMLImageElement>('img')!;image.style.left=`${-100*index}%`;image.alt=['Original pavement photograph','Reference crack mask','Predicted crack mask'][index];this.querySelector('[data-description]')!.textContent=copy[n];if(!reduced)animate(this.querySelector('.comparison-images')!,{opacity:[.3,1],y:[8,0]},{duration:.65});};
 const stop=()=>{clearTimeout(this.timer);playing=false;replay.innerHTML='<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 10a8 8 0 1 1 1 7M4 4v6h6"/></svg>';replay.setAttribute('aria-label','Replay mask sequence');};
 const next=()=>{if(selected===3){stop();return;}this.timer=setTimeout(()=>{show(selected+1);next();},2400);};
 const start=()=>{stop();started=true;playing=true;replay.innerHTML='<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true"><path d="M8 5v14M16 5v14"/></svg>';replay.setAttribute('aria-label','Pause mask sequence');show(0);next();};
 replay.addEventListener('click',()=>playing?stop():start());this.querySelectorAll<HTMLButtonElement>('[data-frame]').forEach(b=>b.addEventListener('click',()=>{started=true;stop();show(Number(b.dataset.frame));}));
 show(reduced?3:0);this.observer=new IntersectionObserver(entries=>entries.forEach(e=>{if(e.isIntersecting&&!started&&!reduced)start();else if(!e.isIntersecting){stop();started=false;}}),{threshold:0,rootMargin:'-20% 0px -20% 0px'});this.observer.observe(this.querySelector('.comparison-images')!);
 }
 disconnectedCallback(){clearTimeout(this.timer);this.observer?.disconnect();}
}
if(!customElements.get('mask-inspector'))customElements.define('mask-inspector',MaskInspector);
</script>
