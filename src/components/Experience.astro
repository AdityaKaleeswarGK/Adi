---
import { getCollection, render } from "astro:content";
const entries = (await getCollection("experience")).sort((a, b) => a.data.order - b.data.order);
const items = await Promise.all(entries.map(async (entry) => ({ id: entry.id, data: entry.data, Content: (await render(entry)).Content })));
---

<ol id="roles" class="glass-light xp-list-wrap" aria-label="Research and engineering roles">
  {items.map((item, i) => {
    const Body = item.Content;
    return (
      <li class="xp" id={item.id}>
        <div class="xp-date">
          <span class="xp-i">{String(i + 1).padStart(2, "0")}</span>
          <span>{item.data.start}</span>
          <span class="xp-dash">—</span>
          <span>{item.data.end}</span>
          {item.data.location && <span class="xp-loc">{item.data.location}</span>}
        </div>
        <article>
          <h2 class="xp-role">{item.data.role}</h2>
          <p class="xp-org">{item.data.org}</p>
          <div class="xp-body"><Body /></div>
          {item.data.links.length > 0 && (
            <nav class="xp-links" aria-label={`${item.data.role} links`}>
              {item.data.links.map((link) => <a href={link.url} target="_blank" rel="noopener noreferrer">{link.label} ↗</a>)}
            </nav>
          )}
        </article>
      </li>
    );
  })}
</ol>
