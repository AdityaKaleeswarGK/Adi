---
import { work } from "../data/work";
---
<div class="work-grid">
  {work.map(item => <article class="work-card">
    <div class="work-card-body">
      <p class="eyebrow">{item.number} / {item.field}</p>
      <h3><a href={`/projects/${item.slug}`}>{item.title} <span>↗</span></a></h3>

      <p class="work-description">{item.description}</p>
      <div class="work-card-bottom"><a href={`/projects/${item.slug}`} aria-label={`Read about ${item.title}`}>Details →</a></div>
    </div>
  </article>)}
</div>
