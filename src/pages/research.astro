---
import BaseLayout from "../layouts/BaseLayout.astro";
import { papers } from "../data/papers";
import { patents } from "../data/patents";
---
<BaseLayout title="Research" description="Papers under review and published Indian patent applications by Aditya Kaleeswar.">
  <div class="orbit-page narrow">
    <h1 class="orbit-title">Research</h1>
    <p class="orbit-lede">Papers under review and published Indian patent applications.</p>

    <section class="glass r-section" aria-labelledby="papers-h">
      <h2 id="papers-h">PAPERS</h2>
      {papers.map((p, i) => (
        <div class="r-row">
          <span class="r-num">[{i + 1}]</span>
          <div class="r-body">
            <p class="r-title">{p.title}</p>
            <p class="r-meta">
              {p.authors.map((a, j) => <>{j > 0 && ", "}{a === "A. Kaleeswar" ? <b>{a}</b> : a}</>)}
              {" · "}<span class="r-status">{p.status}</span>
            </p>
          </div>
        </div>
      ))}
    </section>

    <section class="glass r-section" aria-labelledby="patents-h">
      <h2 id="patents-h">PATENT APPLICATIONS</h2>
      {patents.map((p) => (
        <div class="r-row">
          <span class="r-app">{p.number}</span>
          <p class="r-body r-title" style="font-size:17px;">{p.title}</p>
        </div>
      ))}
    </section>
  </div>
</BaseLayout>
