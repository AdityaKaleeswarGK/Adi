---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { projects, domains } from "../../data/projects";
---

<BaseLayout title="Projects" description="Things I've built — robotics, language models, machine learning and more.">
  <div class="orbit-page" style="max-width: 1100px;">
    <h1 class="orbit-title">Projects</h1>
    <p class="orbit-lede">Highlights up front. Pick a domain or search to see the rest.</p>

    <label for="proj-q" class="sr-only">Search projects</label>
    <input id="proj-q" class="p-search" type="search" placeholder="Search projects…" autocomplete="off" />
    <div class="p-chips" role="group" aria-label="Filter by domain">
      <button type="button" class="p-chip" data-tag="" aria-pressed="true">highlights</button>
      {domains.map((d) => <button type="button" class="p-chip" data-tag={d} aria-pressed="false">{d}</button>)}
    </div>

    <div id="proj-grid" class="p-grid">
      {projects.map((p) => (
        <article
          class="p-card"
          data-featured={p.featured ? "true" : "false"}
          data-tags={p.tags.join("|")}
          data-search={`${p.title} ${p.description} ${p.tags.join(" ")}`.toLowerCase()}
          hidden={!p.featured}
        >
          <div style="display:flex;justify-content:space-between;align-items:flex-start;gap:12px;">
            <h2>{p.title}</h2>
            {p.working && <span class="working">● working</span>}
          </div>
          <p>{p.description}</p>
          {p.tags.length > 0 && <div class="p-tags">{p.tags.map((t) => <span class="p-tag">{t}</span>)}</div>}
          <div class="p-foot">
            <a href={p.link} target="_blank" rel="noopener noreferrer" aria-label={`${p.title} on GitHub`}>
              <svg aria-hidden="true" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M9 19c-4 1.5-4-2-6-2.5M15 21v-3.5a3 3 0 0 0-.9-2.3c3-.3 6-1.5 6-6.5a5 5 0 0 0-1.4-3.5 4.6 4.6 0 0 0-.1-3.5s-1.1-.3-3.6 1.4a12.4 12.4 0 0 0-6.4 0C6.1 1.4 5 1.7 5 1.7a4.6 4.6 0 0 0-.1 3.5A5 5 0 0 0 3.5 8.7c0 5 3 6.2 6 6.5a3 3 0 0 0-.9 2.3V21"/></svg>
              Repo →
            </a>
          </div>
        </article>
      ))}
    </div>
    <p id="proj-empty" class="p-empty" hidden>No projects match that filter.</p>
  </div>
</BaseLayout>

<script>
  // Re-binds on every page load (view transitions swap the DOM).
  document.addEventListener("astro:page-load", () => {
    const grid = document.getElementById("proj-grid");
    if (!grid) return;
    const search = document.getElementById("proj-q") as HTMLInputElement | null;
    const empty = document.getElementById("proj-empty");
    const cards = [...grid.querySelectorAll<HTMLElement>(".p-card")];
    const chips = [...document.querySelectorAll<HTMLButtonElement>(".p-chip")];
    let tag = "";

    const apply = () => {
      const terms = (search?.value ?? "").trim().toLowerCase().split(/\s+/).filter(Boolean);
      let shown = 0;
      cards.forEach((c) => {
        const tags = (c.dataset.tags ?? "").split("|");
        // no domain and no search → highlights; a search alone looks through everything
        const inScope = tag ? tags.includes(tag) : terms.length > 0 || c.dataset.featured === "true";
        const match = terms.every((t) => (c.dataset.search ?? "").includes(t));
        c.hidden = !(inScope && match);
        if (!c.hidden) shown++;
      });
      if (empty) empty.hidden = shown > 0;
    };

    chips.forEach((chip) =>
      chip.addEventListener("click", () => {
        const next = chip.dataset.tag ?? "";
        tag = next && next === tag ? "" : next;
        chips.forEach((c) => c.setAttribute("aria-pressed", String((c.dataset.tag ?? "") === tag)));
        apply();
      }),
    );
    search?.addEventListener("input", apply);
    apply();
  });
</script>
