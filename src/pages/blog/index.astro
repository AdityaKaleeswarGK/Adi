---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
const posts = (await getCollection("blog", (p) => !p.data.draft && p.data.date <= new Date())).sort((a, b) => +b.data.date - +a.data.date);
---
<BaseLayout title="Blogs" description="Research notes, project stories, and experiments from Aditya Kaleeswar.">
  <div class="orbit-page narrow">
    <h1 class="orbit-title">Blogs</h1>
    <p class="orbit-lede">Project write-ups and research notes.</p>
    {posts.length > 0 && (
      <section class="glass b-list" aria-label="Published writing">
        {posts.map((p) => (
          <a class="b-row" href={p.data.url ?? `/blog/${p.id}`}>
            <span class="b-date">{p.data.date.toLocaleDateString("en-US", { month: "short", year: "numeric", timeZone: "UTC" })}</span>
            <span class="b-body">
              <span class="b-title">{p.data.title}</span>
              {p.data.description && <span class="b-desc">{p.data.description}</span>}
            </span>
            <span class="b-arrow" aria-hidden="true">↗</span>
          </a>
        ))}
      </section>
    )}
  </div>
</BaseLayout>
