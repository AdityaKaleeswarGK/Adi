---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../site.config";
import SocialLinks from "../components/SocialLinks.astro";
import { getCollection } from "astro:content";
const posts = await getCollection('blog', p => !p.data.draft && p.data.date <= new Date());
---
<BaseLayout hideFooter>
  <div class="container-wide home-content">
    <section class="intro-layout">
      <div class="intro-copy">
        <h1>Hey, I’m Aditya.</h1>
        <p class="intro-text">I’m currently researching independently. I don’t confine my work to one domain; I pick problems I find interesting and where I think I can make a meaningful impact. My research spans robotics, machine learning, and embedded systems. Recently, my ML work has focused on benchmarking the coding abilities of language models, evaluation research, and coding-harness development. I’m looking to explore specification gaming and mechanistic interpretability more deeply. Right now, I’m working on safe, constrained reinforcement learning in simulation—and learning more about Formula 1.</p>
        <p class="intro-collaboration">Feel free to get in touch about my work or potential collaborations.</p>
        <SocialLinks class="intro-socials" linkClass="intro-social-link" showEmailAddress />
        <details class="personal-reminder">
          <summary>A reminder I keep <span aria-hidden="true">+</span></summary>
          <div class="reminder-image">
            <img src="/keep-building.jpeg" alt="Raptor 1 and Raptor 3 side by side, with the message: First you make it work. Then you can always make it beautiful." width="1206" height="1425" loading="lazy" decoding="async" />
          </div>
        </details>
      </div>
      <figure class="portrait"><img src={site.heroImage} alt="Aditya sitting in a café" width="769" height="1022" fetchpriority="high"/></figure>
    </section>
    <section class="editorial-section home-blogs">
      <div class="section-heading"><div><h2>Blogs</h2></div><a href="/blog">All posts ↗</a></div>
      {posts.map(post => <a class="notebook-row" href={`/blog/${post.id}`}><div><h3>{post.data.title}</h3><p class="section-description">{post.data.description}</p></div><span>↗</span></a>)}
    </section>
  </div>
</BaseLayout>
