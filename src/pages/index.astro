---
import BaseLayout from "../layouts/BaseLayout.astro";
import FeaturedProjects from "../components/FeaturedProjects.astro";
import { site } from "../site.config";
import ScrollBackdrop from "../components/ScrollBackdrop.astro";
import { getCollection } from "astro:content";
const posts = await getCollection('blog', p => !p.data.draft && p.data.date <= new Date());
---
<BaseLayout hideFooter>
  <ScrollBackdrop />
  <div class="container-wide home-content">
    <section class="intro-layout">
      <div class="intro-copy">
        <p class="eyebrow intro-kicker">Research, experiments & things I build</p>
        <h1>Hi, I’m Aditya.</h1>
        <p class="intro-text">I like exploring different problems and building things along the way. My research interests span <strong>robotics</strong>, <strong>classical machine learning</strong>, and <strong>embedded systems</strong>. Within robotics, I’m especially interested in rovers and traversal algorithms.</p>
        <p class="intro-text">More recently, I’ve been working on <strong>LLM benchmarking in coding environments</strong> and exploring <strong>reward hacking</strong>.</p>
        <p class="intro-current"><span class="status-dot"></span>Currently exploring safe, constrained reinforcement learning in simulation.</p>
        <p class="intro-collaboration">Always open to research collaborations and interesting problems.</p>
        <nav class="intro-socials" aria-label="Social and contact links">
          <a href={`mailto:${site.links.email}`}>Email <span>↗</span></a>
          <a href={site.links.github} target="_blank" rel="noopener noreferrer">GitHub <span>↗</span></a>
          <a href={site.links.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn <span>↗</span></a>
          <a href={site.links.twitter} target="_blank" rel="noopener noreferrer">X / Twitter <span>↗</span></a>
        </nav>
        <details class="personal-reminder">
          <summary>A reminder I keep <span aria-hidden="true">+</span></summary>
          <div class="reminder-image">
            <img src="/keep-building.jpeg" alt="Raptor 1 and Raptor 3 side by side, with the message: First you make it work. Then you can always make it beautiful." width="1206" height="1425" loading="lazy" decoding="async" />
          </div>
        </details>
      </div>
      <figure class="portrait"><img src={site.heroImage} alt="Aditya sitting in a café" width="769" height="1022" fetchpriority="high"/></figure>
    </section>
    <section id="work" class="editorial-section">
      <div class="section-heading"><div><p class="eyebrow">01 / Selected work</p><h2>Things I’ve built.</h2></div><a href="/projects">Explore my GitHub projects ↗</a></div>
      <FeaturedProjects/>
    </section>
    <section class="editorial-section background-section">
      <div><p class="eyebrow">02 / Along the way</p><h2>Experience</h2><a class="text-link" href="/experience">Experience & education ↗</a></div>
      <div class="background-list">
        <div><span class="eyebrow">2026</span><h3>UTRGV · AIM Lab</h3><p>Research intern / uncertainty-aware ML & fracture mechanics</p></div>
        <div><span class="eyebrow">2024–2025</span><h3>Samsung Research · PRISM</h3><p>Research intern / multi-agent data visualization</p></div>
        <div><span class="eyebrow">2024–2025</span><h3>Team Vyadh</h3><p>Autonomous systems / Mars rover navigation & perception</p></div>
      </div>
    </section>
    <section class="editorial-section home-blogs">
      <div class="section-heading"><div><p class="eyebrow">03 / Notes from the work</p><h2>Blogs</h2></div><a href="/blog">All posts ↗</a></div>
      {posts.map(post => <a class="notebook-row" href={`/blog/${post.id}`}><div><h3>{post.data.title}</h3><p class="section-description">{post.data.description}</p></div><span>↗</span></a>)}
    </section>
  </div>
</BaseLayout>
