---
import BaseLayout from "../layouts/BaseLayout.astro";
import FeaturedProjects from "../components/FeaturedProjects.astro";
import { site } from "../site.config";
---
<BaseLayout>
  <div class="container-wide">
    <section class="intro-layout">
      <div class="intro-copy">
        <h1>Hi, I’m Aditya.</h1>
        <p class="intro-text">I’m a computer science graduate exploring robotics, machine learning, and language models.</p>
        <p class="intro-personal">I like building stuff.</p>
        <div class="intro-links"><a class="primary-link" href="#work">Explore my work <span>↓</span></a><a href={site.resumeUrl}>Read my résumé ↗</a></div>
        <details class="personal-reminder">
          <summary>A reminder I keep <span aria-hidden="true">+</span></summary>
          <div class="reminder-image">
            <img src="/keep-building.jpeg" alt="Raptor 1 and Raptor 3 side by side, with the message: First you make it work. Then you can always make it beautiful." width="1206" height="1425" loading="lazy" decoding="async" />
          </div>
        </details>
      </div>
      <figure class="portrait"><img src={site.heroImage} alt="Aditya sitting in a café" width="769" height="1022" fetchpriority="high"/></figure>
    </section>
    <aside class="now-strip"><p class="eyebrow"><span class="status-dot"></span> Currently building</p><div><a href="/now">Stress Stack <span>↗</span></a><p>Turning real repositories into reproducible evaluations for coding models.</p></div><a class="now-more" href="/now">Details →</a></aside>
    <section id="work" class="editorial-section">
      <div class="section-heading"><div><h2>Projects</h2></div><a href="/projects">All projects ↗</a></div>
      <FeaturedProjects/>
    </section>
    <section class="editorial-section background-section">
      <div><h2>Experience</h2><a class="text-link" href="/experience">Experience & education ↗</a></div>
      <div class="background-list">
        <div><span class="eyebrow">2026</span><h3>UTRGV · AIM Lab</h3><p>Research intern / uncertainty-aware ML & fracture mechanics</p></div>
        <div><span class="eyebrow">2024–2025</span><h3>Samsung Research · PRISM</h3><p>Research intern / multi-agent data visualization</p></div>
        <div><span class="eyebrow">2024–2025</span><h3>Team Vyadh</h3><p>Autonomous systems / Mars rover navigation & perception</p></div>
      </div>
    </section>
    <section class="contact-section"><h2>Contact</h2><a href={`mailto:${site.links.email}`}>{site.links.email} ↗</a></section>
  </div>
</BaseLayout>
