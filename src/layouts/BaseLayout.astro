---
import "../styles/global.css";
import "../styles/orbit.css";
import { ClientRouter } from "astro:transitions";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import CommandPalette from "../components/CommandPalette.astro";
import ThumbMenu from "../components/ThumbMenu.astro";
import { site } from "../site.config";

interface Props {
  title?: string;
  description?: string;
  hideFooter?: boolean;
  /** false keeps the jaathagam sky hidden and paused (long-form reading pages) */
  animatedBackground?: boolean;
}

const { title, description, hideFooter = false, animatedBackground = true } = Astro.props;
const pageTitle = title ? `${title} · ${site.name}` : site.title;
const pageDesc = description ?? site.tagline;
// canonical/og:url/og:image only render once `site` is set in astro.config.mjs
// (otherwise a static build would bake in localhost URLs)
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site) : null;
const quickTurn = {
  old: { name: "orbit-out", duration: "70ms", easing: "ease-out", fillMode: "both" },
  new: { name: "orbit-in", duration: "140ms", easing: "ease-out", fillMode: "both" },
};
const pageTurn = { forwards: quickTurn, backwards: quickTurn };
---

<!doctype html>
<html lang="en" transition:animate="none" data-sky={animatedBackground ? "on" : "off"}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="generator" content={Astro.generator} />

    <title>{pageTitle}</title>
    <meta name="description" content={pageDesc} />
    <meta name="author" content={site.name} />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDesc} />
    <meta property="og:type" content="website" />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:site_name" content={site.name} />
    {canonical && <meta property="og:image" content={new URL("/og.png", canonical)} />}
    {canonical && <meta property="og:image:width" content="1200" />}
    {canonical && <meta property="og:image:height" content="630" />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDesc} />
    {canonical && <meta name="twitter:image" content={new URL("/og.png", canonical)} />}
    <meta name="theme-color" content="#030409" />

    <ClientRouter />
  </head>
  <body class="flex min-h-screen flex-col">
    <!-- the jaathagam sky: kept alive across navigations so it only spins in once per visit -->
    <canvas id="sky" aria-hidden="true" transition:persist="sky"></canvas>
    <a href="#main" class="skip-link">Skip to content</a>
    <Nav />
    <main id="main" class="flex-1" transition:animate={pageTurn}>
      <slot />
    </main>
    {!hideFooter && <Footer />}
    <CommandPalette />
    <ThumbMenu />

    <script>
      import { startSky } from "../scripts/sky.js";
      const canvas = document.getElementById("sky");
      if (canvas instanceof HTMLCanvasElement) startSky(canvas);
      // Sections like /#research.
      const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      const hashTarget = () => (location.hash ? document.getElementById(decodeURIComponent(location.hash.slice(1))) : null);
      const jumpToHash = () => hashTarget()?.scrollIntoView({ block: "start", behavior: "instant" });

      // Arriving from another page: be at the section before the new page fades in,
      // instead of fading in at the top and then scrolling down.
      document.addEventListener("astro:after-swap", jumpToHash);
      // A direct visit or the /research redirect lands there too.
      jumpToHash();

      // Already on the page: glide to the section (or back to the top) without a page change.
      document.addEventListener(
        "click",
        (e) => {
          if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
          const link = (e.target as Element | null)?.closest?.("a[href]") as HTMLAnchorElement | null;
          if (!link || link.target === "_blank" || link.hasAttribute("download")) return;
          const url = new URL(link.href, location.href);
          if (url.origin !== location.origin || url.pathname !== location.pathname || url.search !== location.search) return;
          const target = url.hash ? document.getElementById(decodeURIComponent(url.hash.slice(1))) : null;
          if (url.hash && !target) return;
          e.preventDefault();
          const behavior = reduced ? "instant" : "smooth";
          if (target) target.scrollIntoView({ block: "start", behavior });
          else window.scrollTo({ top: 0, behavior });
          if (url.hash !== location.hash) history.pushState(history.state, "", url.pathname + url.search + url.hash);
        },
        true,
      );
    </script>
  </body>
</html>
